flowchart TB
  %% ===== External Entities =====
  L(["Landlord"])
  S(["Student"])
  O(["OSAS Officer"])

  %% ===== Processes (Landlord view) =====
  P2(("P2 - Landlord Registration & Accreditation"))
  P3(("P3 - Property & Room Management"))
  P4(("P4 - Booking & Lease Handling"))
  P5(("P5 - Lease & Payment Management"))
  P6(("P6 - Messaging & Complaints"))
  P7(("P7 - Reviews & Ratings"))

  %% ===== Data Stores =====
  D2[("D2 Landlord Profiles")]
  D3[("D3 Properties & Rooms")]
  D4[("D4 Leases & Payments")]
  D5[("D5 Conversations & Messages")]
  D6[("D6 Complaints & Concerns")]
  D7[("D7 Reviews & Boarding History")]

  %% ===== Flows =====
  L -->|registration & government ID| P2
  P2 -->|create profile| D2
  P2 -->|request accreditation| O
  O -->|accreditation status| D2

  L -->|property & room data| P3
  P3 -->|create / update| D3

  S -->|booking request| P4
  P4 -->|notify| L
  L -->|accept / reject| P4
  P4 -->|confirmed booking| P5

  P5 -->|create lease| D4
  S -->|payment & receipt| P5
  P5 -->|record payment| D4
  P5 -->|confirm payment| O
  O -->|payment verification| D4

  L -->|message| P6
  S -->|message| P6
  P6 -->|store conversation| D5
  S -->|complaint| P6
  P6 -->|create complaint| D6
  P6 -->|route to OSAS| O
  O -->|resolution| D6
  L -->|respond| D6

  S -->|property review| P7
  P7 -->|publish| D7
  L -->|tenant review received| P7
  P7 -->|store rating| D7
