  %% ===== External Entities =====
  A(["Admin"])
  O(["OSAS Officer"])
  S(["Student"])
  L(["Landlord"])

  %% ===== Processes (Admin view) =====
  P1(("P8.1 - Manage Users"))
  P2(("P8.2 - Publish Announcements"))
  P3(("P8.3 - Manage Policies"))
  P4(("P8.4 - View Audit Logs"))
  P5(("P8.5 - Oversee Complaints & OSAS"))

  %% ===== Data Stores =====
  D1[("D1 Student Profiles")]
  D2[("D2 Landlord Profiles")]
  D6[("D6 Complaints & Concerns")]
