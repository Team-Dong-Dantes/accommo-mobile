flowchart TB
  %% ===== External Entities =====
  S(["Student"])
  L(["Landlord"])
  O(["OSAS Officer"])

  %% ===== Processes (Student view) =====
  P1(("P1 - Student Registration & Verification"))
  P4(("P4 - Search, Shortlist & Booking"))
  P5(("P5 - Lease & Payment Management"))
  P6(("P6 - Messaging & Complaints"))
  P7(("P7 - Reviews & Ratings"))

  %% ===== Data Stores =====
  D1[("D1 Student Profiles")]
  D3[("D3 Properties & Rooms")]
  D4[("D4 Leases & Payments")]
  D5[("D5 Conversations & Messages")]
  D6[("D6 Complaints & Concerns")]
  D7[("D7 Reviews & Boarding History")]

  %% ===== Flows =====
  S -->|registration & student ID| P1
  P1 -->|create profile| D1
  P1 -->|submit ID for validation| O
  O -->|verification result| D1

  S -->|search criteria| P4
  P4 -->|read listings| D3
  P4 -->|shortlist| D3
  P4 -->|booking request| L
  L -->|accept / reject| P4
  P4 -->|confirmed booking| P5

  P5 -->|create lease| D4
  S -->|payment & receipt| P5
  P5 -->|record payment| D4
  P5 -->|confirm payment| O
  O -->|payment verification| D4

  S -->|message| P6
  L -->|message| P6
  P6 -->|store conversation| D5
  S -->|complaint| P6
  P6 -->|create complaint| D6
  P6 -->|route to OSAS| O
  O -->|resolution| D6

  S -->|property / landlord review| P7
  P7 -->|publish| D7
