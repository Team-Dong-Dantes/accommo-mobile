  P412 -->|read| D3
  P412 -->|matches| P413
  P413 -->|ranked| D3
  P413 -->|results| S

  S -->|booking request| P451
  P451 -->|check room| D3
  P451 -->|available| P452
  P452 -->|notify| L
  L -->|accept / reject| P453
  P453 -->|accepted| P454
  P454 -->|pending lease| D4

  S -->|receipt file| P531
  P531 -->|valid| P532
  P532 -->|proof| D4
  P532 -->|send for confirm| P541
  P541 -->|ledger check| D4
  P541 -->|match| P542
  O -->|confirm| P542
  P542 -->|verified| D4

  S -->|complaint| P641
