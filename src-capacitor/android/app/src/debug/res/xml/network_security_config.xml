<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: overrides main/res/xml/network_security_config.xml so
     live reload (`npm run dev:android`) can load the dev server over plain http
     through `adb reverse`. Release builds never see this file. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">iconify.design</domain>
        <domain includeSubdomains="true">simplesvg.com</domain>
        <domain includeSubdomains="true">unisvg.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <domain includeSubdomains="true">isu.edu.ph</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
