# Client-side config. Vite/Quasar only inlines VITE_-prefixed vars, and each one
# must also be listed in quasar.config.ts build.define or it never reaches the
# app. (The NEXT_PUBLIC_* names Supabase's dashboard shows are Next.js
# conventions — they do nothing here.)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

VITE_MAPBOX_TOKEN=pk.your-mapbox-token

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Set in a gitignored .env.local to run against fixtures with no backend:
# VITE_DEMO_MODE=true
